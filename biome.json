{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "includes": [
      "**",
      "!!**/.next",
      "!next-env.d.ts",
      "!lib/datocms/graphql-env.d.ts",
      "!schema.graphql"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "warn"
      },
      "correctness": {
        "noUnknownProperty": {
          "level": "error",
          "options": { "ignore": ["timeline-trigger", "animation-trigger"] }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  }
}

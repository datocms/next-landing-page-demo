{
  "name": "startup-nextjs-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x || 26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint . && gql.tada check",
    "format": "biome check . --write --unsafe --diagnostic-level=error && biome format --diagnostic-level=error --write .",
    "generate-schema": "dotenv -c -- bash -c 'gql.tada generate schema https://graphql.datocms.com --header \"X-Exclude-Invalid: true\" --header \"Authorization: $DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN\" && gql.tada generate-output'"
  },
  "dependencies": {
    "@datocms/cda-client": "^0.3.2",
    "@datocms/cma-client-node": "^6.1.3",
    "@datocms/content-link": "^0.3.23",
    "@formatjs/intl-localematcher": "^0.9.0",
    "datocms-structured-text-utils": "^6.0.1",
    "got": "^16.1.0",
    "gql.tada": "^1.11.4",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.57.0",
    "negotiator": "^1.1.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-datocms": "^8.1.2",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
